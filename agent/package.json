    "postinstall": "patch-package",
    "smoke:card": "tsx scripts/smoke-card.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^0.6.8",
    "@chaoschain/sdk": "^0.3.3",
    "@hono/node-server": "^1.13.7",
    "ethers": "^6.15.0",
    "hono": "^4.6.14",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
