{
  "name": "agentstate-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "register": "tsx bin/register.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:arkiv": "tsx scripts/smoke-arkiv.ts",
    "smoke:identity": "tsx scripts/smoke-identity.ts",
    "smoke:brain": "tsx scripts/smoke-brain.ts",
