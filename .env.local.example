# Privy app id (https://dashboard.privy.io) — embedded wallet auth
NEXT_PUBLIC_PRIVY_APP_ID=

# Arkiv namespace — MUST match the agent service's PROJECT_VALUE
NEXT_PUBLIC_PROJECT_VALUE=agentstate-CHANGE-ME

# Stateless AI/IPFS service (agent/)
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
AGENT_ORIGIN=http://localhost:8787

# ENS / NameStone — get a key + enable your domain at https://namestone.com
# (server-side secret — never prefix with NEXT_PUBLIC)
NAMESTONE_API_KEY=
NAMESTONE_BASE_URL=https://namestone.com/api/public_v1_sepolia
ENS_ROOT_DOMAIN=ark-hive.eth
NEXT_PUBLIC_ENS_ROOT_DOMAIN=ark-hive.eth
